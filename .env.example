# Copy to .env and adjust. docker compose reads .env automatically.
DB_NAME=itsm
DB_USER=itsm
DB_PASSWORD=itsm
DB_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=4321

# --- Authentication ---
# HS256 signing secret for JWTs: at least 32 bytes. Generate one with: openssl rand -base64 48
# Change it for anything other than local development.
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789
# Token lifetime (Spring duration format, e.g. 30m, 8h, 1d)
JWT_TTL=8h
# Bootstrap administrator, created at startup only if no administrator exists yet.
ADMIN_EMAIL=admin@itsm.local
ADMIN_PASSWORD=ChangeMe123!
