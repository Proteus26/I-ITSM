---
import Layout from '../layouts/Layout.astro';
import { ApiError } from '../lib/errors';
import { BackendClient } from '../lib/backend';
import type { Ping } from '../lib/types';

const { user } = Astro.locals;
let ping: Ping | null = null;
let error: string | null = null;
try {
  ping = await new BackendClient().ping();
} catch (e) {
  error = e instanceof ApiError ? e.userMessage : 'Unexpected error.';
}
---

<Layout title="I-ITSM">
  <h1>I-ITSM</h1>
  <p>Intelligent IT Service Management.</p>
  <p>
    {
      user ? (
        <a class="btn" href="/dashboard">Go to dashboard</a>
      ) : (
        <>
          <a class="btn" href="/login">Log in</a> <a class="btn btn-secondary" href="/register">Register</a>
        </>
      )
    }
  </p>

  <h2>Backend status</h2>
  {ping ? <p>✅ {ping.service} is {ping.status} ({ping.time})</p> : <p>❌ Backend unreachable: {error}</p>}
</Layout>
