---
import Layout from '../layouts/Layout.astro';
import RoleBadge from '../components/RoleBadge.astro';
import { levelLabel } from '../lib/forms';
import { loginUrl } from '../lib/redirect';

// The middleware guarantees a user on /dashboard (see ROUTE_RULES in src/lib/access.ts); this keeps the types honest.
const user = Astro.locals.user;
if (!user) return Astro.redirect(loginUrl(Astro.url.pathname + Astro.url.search));
const tech = user.technician;
---

<Layout title="Dashboard · I-ITSM">
  <h1>Hello, {user.fullName}</h1>
  <p>You are logged in as <RoleBadge role={user.role} />.</p>

  <div class="action-grid">
    <section class="card">
      <h2>Report an incident</h2>
      <p class="muted">Something is not working? Tell us about it.</p>
      <p><a class="btn" href="/incidents/new">Report an incident</a></p>
    </section>
    <section class="card">
      <h2>My incidents</h2>
      <p class="muted">Follow the incidents you reported.</p>
      <p><a href="/incidents?tab=mine">View my incidents</a></p>
    </section>
    {
      user.role === 'TECHNICIAN' && (
        <section class="card">
          <h2>Assigned to me</h2>
          <p class="muted">The incidents you are working on.</p>
          <p><a href="/incidents?tab=assigned">View assigned incidents</a></p>
        </section>
      )
    }
    {
      user.role === 'ADMIN' && (
        <section class="card">
          <h2>Administration</h2>
          <ul class="plain-list">
            <li><a href="/admin/reports">Reports</a></li>
            <li><a href="/search">Search incidents</a></li>
            <li><a href="/admin/users">Manage users</a></li>
            <li><a href="/admin/categories">Categories</a></li>
            <li><a href="/admin/settings">Settings</a></li>
          </ul>
        </section>
      )
    }
  </div>
  {
    tech && (
      <section class="card">
        <h2>Technician profile</h2>
        <dl class="details">
          <dt>Level</dt><dd>{levelLabel(tech.level)}</dd>
          <dt>Max active incidents</dt><dd>{tech.maxActiveIncidents}</dd>
          <dt>Available</dt><dd>{tech.available ? 'Yes' : 'No'}</dd>
          <dt>Skills</dt><dd>{tech.skills.length ? tech.skills.join(', ') : 'None'}</dd>
        </dl>
      </section>
    )
  }
</Layout>
