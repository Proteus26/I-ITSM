---
import Layout from '../layouts/Layout.astro';
import FormField from '../components/FormField.astro';
import Alert from '../components/Alert.astro';
import RoleBadge from '../components/RoleBadge.astro';
import { backendFor } from '../lib/backend';
import { loginUrl } from '../lib/redirect';
import { formatDate, formatDateTime, levelLabel } from '../lib/forms';
import { initialAccountState, processAccountPost, type AccountState } from '../lib/accountForms';

// The middleware guarantees a user on /account (see ROUTE_RULES in src/lib/access.ts); this keeps the types honest.
const user = Astro.locals.user;
if (!user) return Astro.redirect(loginUrl(Astro.url.pathname + Astro.url.search));

// Only a GET (after a redirect) shows a notice; the forms post to plain /account so they never carry ?notice=.
const NOTICES: Record<string, string> = { changed: 'Your password was changed.', profile: 'Your profile was saved.' };
const notice = Astro.request.method === 'GET' ? NOTICES[Astro.url.searchParams.get('notice') ?? ''] : undefined;

// Each form posts a hidden `intent`; errors are shown on the card of the form that failed (see lib/accountForms.ts).
let state: AccountState = initialAccountState(user);

if (Astro.request.method === 'POST') {
  const result = await processAccountPost(await Astro.request.formData(), {
    user,
    api: backendFor(Astro.cookies),
    cookies: Astro.cookies,
    ctx: Astro,
  });
  if (result.kind === 'response') return result.response;
  state = result.state;
  Astro.response.status = result.status;
}
const { errors, profileFieldErrors, passwordFieldErrors } = state;
const tech = user.technician;
---

<Layout title="Account · I-ITSM">
  <h1>Account</h1>
  {notice && <Alert kind="success">{notice}</Alert>}
  {errors.page && <Alert kind="error">{errors.page}</Alert>}

  <section class="card" aria-labelledby="h-profile">
    <h2 id="h-profile">Profile</h2>
    <dl class="details">
      <dt>Name</dt><dd>{user.fullName}</dd>
      <dt>Email</dt><dd>{user.email}</dd>
      <dt>Role</dt><dd><RoleBadge role={user.role} /></dd>
      {user.department && <><dt>Department</dt><dd>{user.department}</dd></>}
      {
        tech && (
          <>
            <dt>Level</dt><dd>{levelLabel(tech.level)}</dd>
            <dt>Skills</dt><dd>{tech.skills.length ? tech.skills.join(', ') : 'None'}</dd>
          </>
        )
      }
      <dt>Member since</dt><dd>{formatDate(user.createdAt)}</dd>
      <dt>Previous login</dt><dd>{user.previousLoginAt ? formatDateTime(user.previousLoginAt) : 'This is your first login'}</dd>
    </dl>
  </section>

  <section class="card card-sm" aria-labelledby="h-edit-profile">
    <h2 id="h-edit-profile">Edit profile</h2>
    {errors.profile && <Alert kind="error" id="profile-error">{errors.profile}</Alert>}
    <form method="post" action="/account" aria-describedby={errors.profile ? 'profile-error' : undefined}>
      <p class="hint required-hint">* required</p>
      <input type="hidden" name="intent" value="update-profile" />
      <FormField name="fullName" label="Full name" value={state.shownName} error={profileFieldErrors.fullName} autocomplete="name" maxlength={255} required />
      {user.role === 'EMPLOYEE' && <FormField name="department" label="Department (optional)" value={state.shownDepartment} error={profileFieldErrors.department} maxlength={255} />}
      <button class="btn" type="submit">Save profile</button>
    </form>
  </section>

  <section class="card card-sm" aria-labelledby="h-password">
    <h2 id="h-password">Change password</h2>
    {errors.password && <Alert kind="error" id="password-error">{errors.password}</Alert>}
    <form method="post" action="/account" aria-describedby={errors.password ? 'password-error' : undefined}>
      <p class="hint required-hint">* required</p>
      <input type="hidden" name="intent" value="change-password" />
      <FormField name="currentPassword" label="Current password" type="password" error={passwordFieldErrors.currentPassword} autocomplete="current-password" required />
      <FormField name="newPassword" label="New password" type="password" error={passwordFieldErrors.newPassword} hint="8 to 72 characters." autocomplete="new-password" required />
      <FormField name="confirmPassword" label="Confirm new password" type="password" error={passwordFieldErrors.confirmPassword} autocomplete="new-password" required />
      <button class="btn" type="submit">Change password</button>
    </form>
  </section>

  <section class="card card-sm" aria-labelledby="h-sessions">
    <h2 id="h-sessions">Sessions</h2>
    {errors.sessions && <Alert kind="error" id="sessions-error">{errors.sessions}</Alert>}
    <p class="muted">Logging out only ends the session on this device. Use this to end every session, everywhere.</p>
    <form
      method="post"
      action="/account"
      data-confirm="Log out of all devices? You will need to log in again everywhere."
      aria-describedby={errors.sessions ? 'sessions-error' : undefined}
    >
      <input type="hidden" name="intent" value="logout-all" />
      <button class="btn btn-danger" type="submit">Log out of all devices</button>
    </form>
  </section>
</Layout>
