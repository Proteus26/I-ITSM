---
import Layout from '../../layouts/Layout.astro';
import Alert from '../../components/Alert.astro';
import FormField from '../../components/FormField.astro';
import { backendFor } from '../../lib/backend';
import { SETTING_DEFS, optionsFor, settingFieldErrors, parseSettingsForm, settingValue } from '../../lib/adminSettings';
import { formErrorState, lookupNotice } from '../../lib/forms';
import { dispatchIntent, UNKNOWN_INTENT_MESSAGE } from '../../lib/intent';
import { handleLoadError } from '../../lib/loadError';
import type { SettingItem } from '../../lib/incidentTypes';

const api = backendFor(Astro.cookies);
const NOTICES: Record<string, string> = { saved: 'Settings saved.', unchanged: 'Nothing changed.' };
const notice = Astro.request.method === 'GET' ? lookupNotice(NOTICES, Astro.url.searchParams.get('notice')) : undefined;

let settings: SettingItem[] = [];
let error: string | null = null;
let loadError: string | null = null;
try {
  settings = await api.getSettings();
} catch (e) {
  const r = await handleLoadError(e, Astro);
  if (r instanceof Response) return r;
  loadError = r.userMessage;
  Astro.response.status = r.status;
}

let fieldErrors: Record<string, string> = {};
/** Settings of a partly failed save: which were stored and which were not. */
let savedLabels: string[] = [];
let failedLabel = '';
let shown: Record<string, string> = {};

if (!loadError && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  shown = Object.fromEntries([...form.entries()].filter((e): e is [string, string] => typeof e[1] === 'string'));
  try {
    const result = await dispatchIntent<Response | undefined>(form, {
      save: async () => {
        const parsed = parseSettingsForm(form, settings);
        if (!parsed.ok) {
          fieldErrors = parsed.errors;
          error = 'Please fix the highlighted fields.';
          Astro.response.status = 400;
          return;
        }
        // One PUT per setting: when one fails, the ones before it are already stored, so say which is which.
        const saved: string[] = [];
        for (const u of parsed.value) {
          const def = SETTING_DEFS.find((d) => d.key === u.key)!;
          try {
            await api.updateSetting(u.key, u.value);
            saved.push(def.label);
          } catch (e) {
            const r = await handleLoadError(e, Astro, { inlineServerErrors: true });
            if (r instanceof Response) return r;
            const state = formErrorState(r);
            fieldErrors = settingFieldErrors(def, state.fieldErrors);
            if (!fieldErrors[def.field]) fieldErrors[def.field] = state.message;
            savedLabels = saved;
            failedLabel = def.label;
            const notTried = parsed.value.slice(saved.length + 1).length;
            error = `${def.label} could not be saved.` +
              (saved.length > 0 ? ` Already saved: ${saved.join(', ')}.` : ' Nothing was saved.') +
              (notTried > 0 ? ' The remaining settings were not saved.' : '');
            Astro.response.status = r.status;
            // Show what is stored now.
            try { settings = await api.getSettings(); } catch { /* keep the list as loaded */ }
            return;
          }
        }
        return Astro.redirect(`/admin/settings?notice=${parsed.value.length > 0 ? 'saved' : 'unchanged'}`);
      },
    });
    if (!result.known) {
      error = UNKNOWN_INTENT_MESSAGE;
      Astro.response.status = 400;
    } else if (result.value) {
      return result.value;
    }
  } catch (e) {
    const r = await handleLoadError(e, Astro, { inlineServerErrors: true });
    if (r instanceof Response) return r;
    const state = formErrorState(r);
    fieldErrors = { ...state.fieldErrors };
    // A rejected `value` belongs to the setting that was being saved; show it as a general error.
    error = state.message;
    Astro.response.status = r.status;
  }
}
const settingsPosted = shown.intent === 'save';
const settingFailed = failedLabel !== '';
---

<Layout title="Settings · I-ITSM">
  <h1>Settings</h1>
  {notice && <Alert kind="success">{notice}</Alert>}
  {error && <Alert kind="error">{error}</Alert>}
  {settingFailed && savedLabels.length > 0 && <Alert kind="success">Saved: {savedLabels.join(', ')}.</Alert>}
  {loadError && <Alert kind="error">{loadError}</Alert>}

  {
    !loadError && (
      <>
        <section class="card card-md" aria-labelledby="h-strategies">
          <h2 id="h-strategies">Strategies</h2>
          <form method="post" action="/admin/settings">
            <input type="hidden" name="intent" value="save" />
            {SETTING_DEFS.map((def) => {
              const current = settingValue(settings, def.key);
              return (
                <FormField
                  name={def.field}
                  label={def.label}
                  value={settingsPosted && !savedLabels.includes(def.label) ? (shown[def.field] ?? '') : (current ?? def.options[0]!.value)}
                  options={optionsFor(def, current)}
                  hint={def.hint}
                  error={fieldErrors[def.field]}
                />
              );
            })}
            <button class="btn" type="submit">Save settings</button>
          </form>
        </section>

        <section class="card card-md" aria-labelledby="h-services">
          <h2 id="h-services">Services and SLA</h2>
          <p>
            The service catalog (names, criticality, owner team, active or not) is managed on <a href="/admin/services">IT services</a>.
            Response and resolution targets are managed on <a href="/admin/sla">SLA policies</a>.
          </p>
        </section>
      </>
    )
  }
</Layout>
