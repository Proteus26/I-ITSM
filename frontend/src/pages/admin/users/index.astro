---
import Layout from '../../../layouts/Layout.astro';
import Alert from '../../../components/Alert.astro';
import RoleBadge from '../../../components/RoleBadge.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import { backendFor } from '../../../lib/backend';
import { handleLoadError } from '../../../lib/loadError';
import { formatDate, formatDateTime, levelLabel, PAGE_BOUNDS, parseOptionalInt, parseRole, pluralize, roleLabel } from '../../../lib/forms';
import { ROLES } from '../../../lib/types';

const params = Astro.url.searchParams;
const role = parseRole(params.get('role') ?? '');
const activeParam = params.get('active');
const active = activeParam === 'true' ? true : activeParam === 'false' ? false : undefined;
const q = (params.get('q') ?? '').trim();
const page = parseOptionalInt(params.get('page') ?? '', PAGE_BOUNDS) ?? 0;

let result = null;
let error: string | null = null;
try {
  result = await backendFor(Astro.cookies).listUsers({ role, active, q: q || undefined, page, size: 20 });
} catch (e) {
  const r = await handleLoadError(e, Astro);
  if (r instanceof Response) return r;
  error = r.userMessage;
  Astro.response.status = r.status;
}

// A page past the end (e.g. after filtering or deleting): go to the last page, keeping the filters.
if (result && result.totalPages > 0 && page >= result.totalPages) {
  return Astro.redirect(pageHref(result.totalPages - 1));
}

const filtered = !!role || active !== undefined || !!q;

function pageHref(p: number): string {
  const sp = new URLSearchParams();
  if (role) sp.set('role', role);
  if (active !== undefined) sp.set('active', String(active));
  if (q) sp.set('q', q);
  sp.set('page', String(p));
  return `/admin/users?${sp}`;
}
---

<Layout title="Users · I-ITSM">
  <div class="row-between">
    <h1>Users</h1>
    <a class="btn" href="/admin/users/new">Create user</a>
  </div>

  <form method="get" class="card filters" role="search" aria-label="Filter users">
    <div class="field">
      <label for="f-q">Search</label>
      <input id="f-q" name="q" type="search" value={q} placeholder="Name or email" />
    </div>
    <div class="field">
      <label for="f-role">Role</label>
      <select id="f-role" name="role">
        <option value="">All</option>
        {ROLES.map((r) => <option value={r} selected={r === role}>{roleLabel(r)}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="f-active">Status</label>
      <select id="f-active" name="active">
        <option value="">All</option>
        <option value="true" selected={active === true}>Active</option>
        <option value="false" selected={active === false}>Deactivated</option>
      </select>
    </div>
    <div class="filter-actions">
      <button class="btn" type="submit">Filter</button>
      <a href="/admin/users">Reset</a>
    </div>
  </form>

  {error && <Alert kind="error">{error}</Alert>}

  {
    result && (
      <>
        <p class="muted">{pluralize(result.totalElements, 'user')}</p>
        {result.content.length === 0 ? (
          <div class="card empty-state">
            <p>{filtered ? 'No users match these filters.' : 'There are no users yet.'}</p>
            {filtered && <p><a href="/admin/users">Clear filters</a></p>}
          </div>
        ) : (
          <div class="table-wrap" role="region" aria-label="Users" tabindex="0">
            <table class="stack">
              <caption class="sr-only">Users</caption>
              <thead>
                <tr>
                  <th scope="col">Name</th>
                  <th scope="col">Email</th>
                  <th scope="col">Role</th>
                  <th scope="col">Status</th>
                  <th scope="col">Technician</th>
                  <th scope="col">Created</th>
                  <th scope="col">Last login</th>
                </tr>
              </thead>
              <tbody>
                {result.content.map((u) => (
                  <tr>
                    <td data-label="Name"><a href={`/admin/users/${u.id}`}>{u.fullName}</a></td>
                    <td data-label="Email">{u.email}</td>
                    <td data-label="Role"><RoleBadge role={u.role} /></td>
                    <td data-label="Status"><StatusBadge active={u.active} /></td>
                    <td data-label="Details">
                      {u.technician
                        ? `${levelLabel(u.technician.level)}${u.technician.skills.length ? ` · ${u.technician.skills.join(', ')}` : ''}`
                        : u.department ?? '—'}
                    </td>
                    <td data-label="Created">{formatDate(u.createdAt)}</td>
                    <td data-label="Last login">
                      {u.lastLoginAt ? <time datetime={u.lastLoginAt} title={formatDateTime(u.lastLoginAt)}>{formatDate(u.lastLoginAt)}</time> : 'Never'}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        <nav class="pager" aria-label="Pagination">
          {result.page > 0 ? <a href={pageHref(result.page - 1)} rel="prev">Previous</a> : <span class="muted">Previous</span>}
          <span>Page {result.page + 1} of {Math.max(result.totalPages, 1)}</span>
          {result.page + 1 < result.totalPages ? <a href={pageHref(result.page + 1)} rel="next">Next</a> : <span class="muted">Next</span>}
        </nav>
      </>
    )
  }
</Layout>
