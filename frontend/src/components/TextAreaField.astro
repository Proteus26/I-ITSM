---
// Like FormField, for multi-line text.
interface Props {
  name: string;
  label: string;
  value?: string | null;
  error?: string | undefined;
  hint?: string;
  required?: boolean;
  maxlength?: number;
  rows?: number;
  /** Prefix for the element id, when the same field name appears in several forms on one page. */
  idPrefix?: string;
}
const { name, label, value = '', error, hint, required = false, maxlength, rows = 4, idPrefix = 'f' } = Astro.props;
const id = `${idPrefix}-${name}`;
const describedBy = [error ? `${id}-error` : null, hint ? `${id}-hint` : null].filter(Boolean).join(' ') || undefined;
---

<div class="field">
  <label for={id}>{label}{required && <span aria-hidden="true"> *</span>}</label>
  <textarea id={id} name={name} rows={rows} maxlength={maxlength} required={required} aria-invalid={error ? 'true' : undefined} aria-describedby={describedBy}>{value ?? ''}</textarea>
  {hint && <p class="hint" id={`${id}-hint`}>{hint}</p>}
  {error && <p class="error" id={`${id}-error`}><span class="sr-only">Error: </span>{error}</p>}
</div>
